{
  "name": "sentinel-ai-security",
  "version": "0.1.0",
  "private": true,
  "description": "A secure-by-default AI-assisted code assurance dashboard.",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "security:audit": "npm audit --audit-level=high",
    "security:signatures": "npm audit signatures"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.10",
    "@babel/core": "7.29.7",
    "js-yaml": "4.3.0",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.16"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.7"
    }
  },
  "type": "module"
}
